{
  "name": "flowpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/lib/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "watchdog": "node scripts/codex-watchdog.mjs",
    "watchdog:once": "node scripts/codex-watchdog.mjs --once"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@tanstack/react-query": "^5.67.2",
    "bullmq": "^5.43.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.39.1",
    "expr-eval": "^2.0.2",
    "ioredis": "^5.4.2",
    "next": "14.2.29",
    "next-auth": "5.0.0-beta.25",
    "pino": "^9.6.0",
    "pg": "^8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vm2": "^3.9.19",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^20.17.19",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.29",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
